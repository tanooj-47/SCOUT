# SCOUT Environment Configuration Blueprint
# Duplicate this file to .env in local development: cp .env.example .env

# Application Environment (development, staging, production)
APP_ENV=development

# Debug Mode (true/false)
DEBUG=true

# Project Metadata
PROJECT_NAME=SCOUT

# API Routing Prefix
API_V1_STR=/api/v1

# CORS Allowed Origins (JSON array format)
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Database Credentials (Local Development)
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=scout_admin
POSTGRES_PASSWORD=replace_with_your_local_password
POSTGRES_DB=scout

# Storage Configuration
STORAGE_DIR=storage
MAX_UPLOAD_SIZE_BYTES=10485760

# Environmental Data Subsystem
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal
ENVIRONMENTAL_REQUEST_TIMEOUT_SECONDS=5.0
ENVIRONMENTAL_MAX_RETRIES=2
ENVIRONMENTAL_BACKOFF_FACTOR=0.5
ENVIRONMENTAL_CURRENT_CACHE_TTL_SECONDS=1800
ENVIRONMENTAL_FORECAST_CACHE_TTL_SECONDS=7200
ENVIRONMENTAL_HISTORICAL_CACHE_TTL_SECONDS=86400

